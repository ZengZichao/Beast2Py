            <distribution id="birthRate.prior" spec="beast.base.inference.distribution.Prior" x="@birthRate">
                <distr spec="beast.base.inference.distribution.LogNormalDistributionModel" id="birthRate.distr">
                    <parameter name="M" value="0.0"/>
                    <parameter name="S" value="2.0"/>
                </distr>
            </distribution>
            <distribution id="alignment.gammaShape.prior" spec="beast.base.inference.distribution.Prior" x="@alignment.gammaShape">
