            </distribution>
            <distribution id="alignment.freqParameter.prior" spec="beast.base.inference.distribution.Prior" x="@alignment.freqParameter">
                <distr spec="beast.base.inference.distribution.Uniform" id="alignment.freqParameter.distr" lower="0.0" upper="1.0"/>
            </distribution>
        </distribution>
        <distribution id="likelihood" spec="CompoundDistribution">
            <distribution id="alignment.treeLikelihood" spec="TreeLikelihood" data="@alignment" tree="@tree">
