    <distribution id="posterior" spec="CompoundDistribution">
        <distribution id="prior" spec="CompoundDistribution">
            <distribution id="yule" spec="beast.base.evolution.speciation.YuleModel" tree="@tree">
                <parameter name="birthDiffRate" idref="birthRate"/>
            </distribution>
            <distribution id="homininaMRCA" spec="beast.base.evolution.tree.MRCAPrior" tree="@tree" monophyletic="true">
                <taxonset idref="homininaMRCA.taxonset"/>
                <distr spec="beast.base.inference.distribution.LogNormalDistributionModel" id="homininaMRCA.distr" offset="6.5">
                    <parameter name="M" value="0.35"/>
                    <parameter name="S" value="0.4"/>
                </distr>
            </distribution>
            <distribution id="alignment.clockRate.prior" spec="beast.base.inference.distribution.Prior" x="@alignment.clockRate">
                <distr spec="beast.base.inference.distribution.LogNormalDistributionModel" id="alignment.clockRate.distr">
                    <parameter name="M" value="0.0"/>
                    <parameter name="S" value="1.0"/>
                </distr>
            </distribution>
            <distribution id="alignment.hky.kappa.prior" spec="beast.base.inference.distribution.Prior" x="@alignment.hky.kappa">
                <distr spec="beast.base.inference.distribution.LogNormalDistributionModel" id="alignment.hky.kappa.distr">
                    <parameter name="M" value="0.0"/>
                    <parameter name="S" value="1.0"/>
                </distr>
