            <parameter id="alignment.hky.kappa" name="stateNode" value="2" dimension="1" estimate="true" lower="0"/>
            <parameter id="alignment.freqParameter" name="stateNode" value="0.25 0.25 0.25 0.25" dimension="4" estimate="true" lower="0" upper="1"/>
            <parameter id="alignment.clockRate" name="stateNode" value="1" dimension="1" estimate="true" lower="0"/>
        </state>
        <distribution idref="posterior"/>
        <operator id="treeScaler" spec="ScaleOperator" scaleFactor="0.75" weight="3.0" tree="@tree"/>
        <operator spec="beast.base.evolution.operator.Uniform" weight="30.0" tree="@tree"/>
        <operator spec="SubtreeSlide" weight="15.0" gaussian="true" size="1.7" tree="@tree"/>
        <operator id="narrow" spec="Exchange" isNarrow="true" weight="15.0" tree="@tree"/>
        <operator id="wide" spec="Exchange" isNarrow="false" weight="3.0" tree="@tree"/>
        <operator spec="WilsonBalding" weight="1.0" tree="@tree"/>
        <operator spec="UpDownOperator" scaleFactor="0.75" weight="3.0" down="@tree" up="@alignment.clockRate"/>
        <operator id="alignment.kappaScaler" spec="ScaleOperator" scaleFactor="0.75" weight="0.1" parameter="@alignment.hky.kappa"/>
